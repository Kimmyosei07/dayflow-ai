# ------------------------------------------------------------------
# DAYFLOW AI — server-side environment variables
# Copy this file to `.env` for local development (`netlify dev` reads it)
# and add the same variables in Netlify: Site configuration > Environment variables.
#
# These are read ONLY by the Netlify Function (netlify/functions/ai.js).
# Never prefix them with VITE_ — that would expose them to the browser.
# ------------------------------------------------------------------

# Google Gemini key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Default provider when the user chooses "Automatic" in Settings: gemini | claude
AI_PROVIDER=gemini

# Optional model overrides (defaults are set in netlify/functions/lib/providers/*.js)
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-sonnet-5-5
